{
  "name": "iina-streams",
  "version": "0.5.2",
  "private": false,
  "description": "Twitch and YouTube streaming plugin for IINA with draggable glassy chat overlay, read-only Twitch chat, and automatic VOD replay.",
  "scripts": {
    "test": "node --test tests/*.test.js tests_candidate/*.test.js",
    "test:py": "python3 -B -m unittest discover -s tests_candidate -p 'test_*.py'",
    "build": "python3 -B scripts/build.py --output dist/release",
    "link-dev": "bash scripts/link-dev.sh",
    "unlink-dev": "bash scripts/unlink-dev.sh"
  }
}
